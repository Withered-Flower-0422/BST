{
    "compilerOptions": {
        "noImplicitAny": false,
        "strictNullChecks": false,

        "noEmit": true,
        "allowJs": true,
        "checkJs": true,
        "isolatedModules": true,
        "paths": { "Scripts/*.js": ["./*"] },

        "lib": ["ES2025"],
        "target": "es2024"
    }
}
